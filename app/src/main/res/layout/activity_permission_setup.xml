<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp"
    tools:context=".PermissionSetupActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Configuración de Permisos"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@android:color/black"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Para que la aplicación funcione correctamente, necesitamos que concedas los siguientes permisos especiales."
        android:textSize="16sp"
        android:gravity="center"
        android:layout_marginBottom="24dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Permiso 1: Uso de Apps -->
            <LinearLayout
                android:id="@+id/stepUsageStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceso a Datos de Uso"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>

                    <TextView
                        android:id="@+id/tvUsageStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permite a la app monitorear las aplicaciones utilizadas."/>
                </LinearLayout>

                <Button
                    android:id="@+id/btnUsageStats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>

            </LinearLayout>

            <!-- Permiso 2: Notificaciones -->
            <LinearLayout
                android:id="@+id/stepNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notificaciones"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tvNotifStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Requerido para enviar alertas importantes."/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnNotifications"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Permiso 3: Batería -->
            <LinearLayout
                android:id="@+id/stepBattery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Optimización de Batería"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tvBatteryStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evita que el sistema cierre la app para ahorrar energía."/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Permiso 4: Superposición -->
            <LinearLayout
                android:id="@+id/stepOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mostrar sobre otras apps"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tvOverlayStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permite mostrar advertencias y bloquear la pantalla."/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Permiso 5: Accesibilidad -->
            <LinearLayout
                android:id="@+id/stepAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Servicio de Accesibilidad"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tvAccessibilityStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permite detectar contenido y bloquear sitios web."/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Permiso 6: Acceso a Notificaciones -->
            <LinearLayout
                android:id="@+id/stepNotificationListener"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp"
                android:background="@drawable/permission_item_background">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Acceso a Notificaciones"
                        android:textStyle="bold"
                        android:textColor="@android:color/black"/>
                    <TextView
                        android:id="@+id/tvNotifListenerStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Permite leer el contenido de las notificaciones."/>
                </LinearLayout>
                <Button
                    android:id="@+id/btnNotifListener"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Conceder"
                    android:background="@drawable/button_primary"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnFinish"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        android:text="Finalizar Configuración"
        android:textSize="18sp"
        android:enabled="false"
        android:background="@drawable/button_primary"
        android:textColor="@android:color/white"/>

</LinearLayout>